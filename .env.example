# Copy to .env for local use, or enter these as Portainer stack variables.
# No secrets are needed by this stack.

# REQUIRED. Hostnames whose TLS ClientHello ByeDPI splits, space-separated.
# Matching is against the SNI / Host header, on label boundaries: "rarbg.to"
# also covers "www.rarbg.to" but not "xrarbg.to". Keep the list minimal:
# splitting breaks servers that cannot reassemble a split ClientHello
# (observed: nyaa.si), so add a host only after confirming it is blocked.
SPLIT_HOSTS=rarbg.to

# Split position for --tlsrec ("1+s" = 1 byte into the SNI). See README.
TLSREC_POS=1+s

# Address and port the HTTP proxy is published on. 127.0.0.1 keeps it reachable
# only from the Docker host itself (DSM). Do not use 0.0.0.0.
BIND_ADDRESS=127.0.0.1
PROXY_PORT=8888

# Subnet of the "edge" network. Docker relays loopback clients from this
# network's gateway, so PROXY_ALLOW defaults to it. Change both together if the
# subnet collides with an existing network.
EDGE_SUBNET=172.30.88.0/29
PROXY_ALLOW=172.30.88.0/29

# Ports allowed for HTTPS CONNECT tunnels (comma-separated).
CONNECT_PORTS=443

# Optional extra deny regexes for tinyproxy, separated by ";".
EXTRA_DENY_PATTERNS=

# Tinyproxy log level: Critical, Error, Warning, Notice, Connect, Info.
LOG_LEVEL=Connect
MAX_CLIENTS=32
PROXY_TIMEOUT=120
BYEDPI_MAX_CONN=256

# Pinned upstream commit for the ByeDPI build (v0.17.3).
BYEDPI_COMMIT=7efde1b1296eaaa187b70e951894dde17527489c

# --- PAC server (optional, convenient for LAN mode) ---------------------------
# Serves http://<BIND_ADDRESS>:<PAC_PORT>/proxy.pac. A device set to "automatic
# proxy configuration" with that URL then uses the proxy ONLY for the hosts in
# PAC_HOSTS and goes DIRECT for everything else -- no per-device proxy toggling.
#
# PAC_HOSTS defaults to SPLIT_HOSTS, so the auto-config and the actual splitting
# cover the same sites. PAC_PROXY is the HOST:PORT clients should use; it
# defaults to BIND_ADDRESS:PROXY_PORT. For LAN mode set BIND_ADDRESS to the NAS
# LAN IP (both the proxy and this PAC URL then advertise that address).
# PAC_HOSTS=discord.com discord.gg discordapp.com discordapp.net discord.media
# PAC_PROXY=192.168.1.10:8888
PAC_PORT=8080
